APP_ENV=dev
APP_NAME=practical-chat-agent
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=practical_chat_agent
MYSQL_ECHO=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_DELIVERY_ENABLED=true
TELEGRAM_DELIVERY_TIMEOUT_SECONDS=20
OUTBOUND_QUIET_HOURS_START=23:00
OUTBOUND_QUIET_HOURS_END=08:00
OUTBOUND_POLICY_TIMEZONE=Asia/Shanghai
OUTBOUND_FREQUENCY_LIMIT_COUNT=3
OUTBOUND_FREQUENCY_LIMIT_WINDOW_SECONDS=600
OUTBOUND_GROUP_CHAT_DRAFT_ONLY=true
GLM_OCR_API_KEY=
GLM_OCR_MODEL=glm-ocr
DESKTOP_OCR_ENABLED=true
DESKTOP_OCR_TIMEOUT_SECONDS=30
DESKTOP_CAPTURE_DEBUG_DIR=.cache/desktop_captures
MEETING_TRANSCRIBE_API_KEY=
MEETING_TRANSCRIBE_MODEL=glm-asr-2512
MEETING_TRANSCRIBE_ENABLED=true
MEETING_TRANSCRIBE_TIMEOUT_SECONDS=30
MEETING_TRANSCRIBE_EMPTY_RETRY_ENABLED=true
MEETING_TRANSCRIBE_EMPTY_RETRY_PROMPT=这是实时会议中文语音转写，请尽量识别口语、短句和不完整句子；如果有犹豫词也尽量保留。
MEETING_ASSISTANT_ENABLED=true
MEETING_ASSISTANT_MODEL=
MEETING_ASSISTANT_TIMEOUT_SECONDS=20
MEETING_MINUTES_REWRITER_ENABLED=true
MEETING_MINUTES_MODEL=
MEETING_MINUTES_TIMEOUT_SECONDS=30
MEETING_MINUTES_CONTEXT_SEGMENTS=24
MEETING_ASSISTANT_CONTEXT_SEGMENTS=8
MEETING_LIVE_WINDOW_ALPHA=0.92
MEETING_CAPTURE_DEBUG_DIR=.cache/meeting_captures
MEETING_AUDIO_SILENCE_THRESHOLD=0.0015
MEETING_MICROPHONE_BOOST_GAIN=1.8
MEETING_MICROPHONE_PEAK_TARGET=0.92
MEETING_MICROPHONE_SILENCE_FLOOR=0.003
MEETING_MICROPHONE_HIGHPASS_CUTOFF_HZ=80
MEETING_MICROPHONE_TRIM_PADDING_SECONDS=0.12
MEETING_MICROPHONE_COMPRESSOR_THRESHOLD=0.45
MEETING_MICROPHONE_COMPRESSOR_RATIO=3.0
MEETING_MICROPHONE_LIMITER_CEILING=0.96
MEETING_LOOPBACK_SAMPLE_RATE=16000
MEETING_LOOPBACK_DEFAULT_CAPTURE_SECONDS=6
MEETING_LOOPBACK_DEFAULT_CHUNK_SECONDS=5
MEETING_LOOPBACK_PREFERRED_SPEAKER_NAME=
MEETING_MICROPHONE_PREFERRED_DEVICE_NAME=
